{
  "appId": "com.reflens.app",
  "productName": "RefLens",
  "compression": "maximum",
  "electronLanguages": ["en-US"],
  "directories": {
    "output": "release",
    "buildResources": "build-resources"
  },
  "files": [
    "dist/browser/**/*",
    "dist-electron/**/*",
    "!dist-electron/**/*.d.ts",
    "!dist-electron/**/*.js.map",
    {
      "from": "node_modules",
      "to": "node_modules",
      "filter": [
        "dotenv/lib/**",
        "dotenv/package.json",
        "simple-git/dist/**",
        "simple-git/package.json",
        "simple-git/promise.js",
        "electron-log/src/**",
        "electron-log/package.json",
        "electron-store/index.js",
        "electron-store/package.json",
        "conf/**",
        "dot-prop/**",
        "env-paths/**",
        "atomically/**",
        "debounce-fn/**",
        "mimic-fn/**",
        "onetime/**",
        "p-limit/**",
        "p-try/**",
        "pkg-up/**",
        "semver/**",
        "ajv/dist/**",
        "ajv/package.json",
        "ajv-formats/**",
        "json-schema-traverse/**",
        "json-schema-typed/**",
        "fast-deep-equal/**",
        "is-obj/**",
        "type-fest/**",
        "require-from-string/**",
        "uri-js/**",
        "@kwsites/**",
        "@simple-git/**"
      ]
    }
  ],
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] }
    ],
    "category": "public.app-category.developer-tools",
    "darkModeSupport": true
  },
  "dmg": {
    "writeUpdateInfo": false
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ]
  },
  "nsis": {
    "oneClick": true,
    "createDesktopShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] }
    ],
    "category": "Development"
  },
  "asar": true,
  "asarUnpack": []
}
