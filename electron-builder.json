{
  "appId": "com.reflens.app",
  "productName": "RefLens",
  "directories": {
    "output": "release",
    "buildResources": "build-resources"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    {
      "from": "node_modules",
      "to": "node_modules",
      "filter": [
        "simple-git/**/*",
        "electron-store/**/*",
        "electron-log/**/*",
        "conf/**/*",
        "dot-prop/**/*",
        "env-paths/**/*",
        "atomically/**/*"
      ]
    }
  ],
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] }
    ],
    "category": "public.app-category.developer-tools",
    "darkModeSupport": true
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ]
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] }
    ],
    "category": "Development"
  },
  "asar": true
}
